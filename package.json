{
  "name": "corkboards",
  "version": "0.7.66",
  "description": "A customizable multi-column pinned note social feed reader and profile creator built on nostr. Zap bitcoin to creators and receive bitcoin for posts others find valuable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnbnevin/corkboards.git"
  },
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @corkboards/web",
    "build": "npm run build -w @corkboards/web",
    "test": "npm run test -w @corkboards/web"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "vite": "^8.0.13"
  },
  "overrides": {
    "vite": "$vite",
    "@xmldom/xmldom": "^0.9.0",
    "postcss": "^8.5.10"
  }
}
