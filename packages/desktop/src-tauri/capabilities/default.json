{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability — grants event listen/emit and core window/webview access",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default"
  ]
}
